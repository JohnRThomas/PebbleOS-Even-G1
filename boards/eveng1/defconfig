# Even Realities G1 board configuration

CONFIG_SOC_NRF53=y

CONFIG_HAL_NORDIC=y
CONFIG_HAL_NORDIC_NRF5340=y

CONFIG_PLATFORM_FLINT=y

CONFIG_SCREEN_COLOR_DEPTH_BITS_1=y

CONFIG_I2C=y
CONFIG_I2C_NRF5=y

CONFIG_UART=y
CONFIG_UART_NRF5=y

CONFIG_PMIC=y
CONFIG_PMIC_NPM1300=y
# nPM1300 interrupt is not routed to the host
CONFIG_PMIC_NPM1300_IRQ=n

# OPT3007, register compatible with the OPT3001
CONFIG_AMBIENT_LIGHT=y
CONFIG_AMBIENT_LIGHT_OPT3001=y

CONFIG_MIC=y
CONFIG_MIC_NRF5=y

# No backlight or vibration motor; brightness is set over the panel SPI
CONFIG_BACKLIGHT=y
CONFIG_BACKLIGHT_STUB=y

CONFIG_VIBE=y
CONFIG_VIBE_STUB=y

# TODO: LSM6DSO INT1 routing is unknown on G1, needs a polled driver
CONFIG_ACCEL_STUB=y

CONFIG_TEMPERATURE=y
CONFIG_TEMPERATURE_STUB=y

CONFIG_DISPLAY=y
CONFIG_DISPLAY_JBD013VGA_NRF5=y

CONFIG_FLASH=y
CONFIG_FLASH_MX25U25645G=y

CONFIG_OTP=y
CONFIG_OTP_STUB=y

CONFIG_BATTERY=y
CONFIG_BATTERY_PMIC=y

CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_NRF5=y

CONFIG_EXTI=y
CONFIG_EXTI_NRF5=y

CONFIG_GPIO=y
CONFIG_GPIO_NRF5=y

CONFIG_RTC=y
CONFIG_RTC_NRF5=y

CONFIG_RNG=y
CONFIG_RNG_STUB=y

CONFIG_CPUMODE=y
CONFIG_CPUMODE_STUB=y
